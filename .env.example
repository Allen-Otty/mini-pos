# =====================================================================
# DOGO POS — Express payment server: COMPLETE production variable list
# Copy to config/secrets/.env (local) or set in your host's dashboard.
# Required = the server will not do its job without it.
# =====================================================================

# ---------- Core (REQUIRED) ----------
SUPABASE_URL=https://uzwomzkzqrpiumtnniik.supabase.co
SUPABASE_ANON_KEY=            # publishable key (Supabase → Settings → API)
APP_URL=                      # public HTTPS base of THIS server, e.g. https://dogo-pos-api.onrender.com

# ---------- M-Pesa Daraja (required for live STK push) ----------
MPESA_ENVIRONMENT=sandbox     # "production" only after Daraja go-live approval
MPESA_SHORTCODE=              # your Till or Paybill number
MPESA_PASSKEY=                # Lipa na M-Pesa Online passkey (NOT the public sandbox one for live)
MPESA_CONSUMER_KEY=           # from developer.safaricom.co.ke app
MPESA_CONSUMER_SECRET=

# ---------- Paystack (required for card/mobile checkout) ----------
PAYSTACK_SECRET_KEY=          # sk_test_... for testing, sk_live_... for production
PAYSTACK_ENVIRONMENT=sandbox  # "production" with sk_live_...

# ---------- KCB Buni (optional until merchant onboarding) ----------
KCB_SHARED_SECRET=            # webhook HMAC shared secret from KCB Buni
KCB_MERCHANT_CODE=
KCB_APP_KEY=
KCB_APP_SECRET=
KCB_ENVIRONMENT=sandbox

# ---------- Airtel Money (optional until merchant onboarding) ----------
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_MERCHANT_NUMBER=
AIRTEL_ENCRYPTION_KEY=
AIRTEL_ENVIRONMENT=sandbox

# ---------- Telegram admin bot (optional) ----------
TELEGRAM_BOT_TOKEN=           # from @BotFather
TELEGRAM_ADMIN_CHAT_ID=       # YOUR chat id; comma-separate multiple admins.
                              # Data commands are refused to any other chat.

# ---------- Runtime flags ----------
NODE_ENV=production           # disables the payment simulator endpoint
# DEMO_MODE=1                 # ONLY for demo environments: seeds fake ledger rows
