# =====================================================================
# Dogo POS payments server - copy to .env (or config/secrets/.env) and fill in.
# NEVER commit the real file. See PAYMENTS.md for how to get each value.
# =====================================================================

# --- Server -------------------------------------------------------
# Public https:// address of THIS server. Providers send payment results here.
PUBLIC_BASE_URL=https://pay.yourdomain.com
NODE_ENV=production
# Where pending payments are saved so a restart cannot lose them (use a persistent disk/volume)
PAYMENTS_DB_PATH=/var/data/dogopos/payments.json

# --- Supabase (used to check who is calling the payments API) -----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# --- M-Pesa (Safaricom Daraja) -------------------------------------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
# Buy Goods only: the till number (the shortcode above is then the store/head-office number)
MPESA_TILL_NUMBER=

# --- Paystack (hosted checkout: cards + M-Pesa) --------------------
# sk_test_... = test mode, sk_live_... = real money
PAYSTACK_SECRET_KEY=

# --- KCB Buni (M-PESA Express via KCB paybill) ---------------------
KCB_APP_KEY=
KCB_APP_SECRET=
KCB_ENVIRONMENT=uat            # uat | production
KCB_ORG_SHORT_CODE=522522
KCB_ORG_PASS_KEY=
KCB_ACCOUNT=                   # your KCB account number
# Confirm these two against your Buni portal before going live:
# KCB_TOKEN_URL=https://accounts.buni.kcbgroup.com/oauth2/token
# KCB_BASE_URL=https://uat.buni.kcbgroup.com

# --- Airtel Money (Collections) -------------------------------------
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_ENVIRONMENT=uat         # uat | production
AIRTEL_COUNTRY=KE
AIRTEL_CURRENCY=KES

# Demo data (fake transactions) - leave unset for real use
# DEMO_MODE=1
